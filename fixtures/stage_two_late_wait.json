    {"op": "stage.sample", "args": {"sample_id": "h1", "stage_id": "s1", "replica": "a", "at": 3, "digest": "newhash", "healthy": true}},
    {"op": "stage.sample", "args": {"sample_id": "h2", "stage_id": "s1", "replica": "b", "at": 4, "digest": "newhash", "healthy": true}},
    {"op": "stage.decide", "args": {"stage_id": "s1", "at": 5}},
    {"op": "stage.start", "args": {"stage_id": "s2", "plan_id": "p1", "ordinal": 2, "members": [{"replica": "a", "generation": 1}, {"replica": "b", "generation": 1}], "start_ts": 7, "end_ts": 9}},
    {"op": "stage.sample", "args": {"sample_id": "late-a-minute-6", "stage_id": "s1", "replica": "a", "at": 6, "digest": "newhash", "healthy": false}},
    {"op": "stage.decide", "args": {"stage_id": "s1", "at": 7}}
