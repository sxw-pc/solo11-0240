    {"op": "artifact.register", "args": {"artifact_id": "new", "digest": "newhash", "min_api": 2, "max_api": 4}},
    {"op": "artifact.contract", "args": {"artifact_id": "new", "min_protocol": 1, "max_protocol": 2}},
    {"op": "artifact.population", "args": {"service": "svc", "protocol": 1, "count": 10}},
    {"op": "artifact.plan", "args": {"event_id": "e1", "plan_id": "p1", "service": "svc", "artifact_id": "new", "start_ts": 1, "end_ts": 10, "stage_count": 2}},
    {"op": "stage.start", "args": {"stage_id": "s1", "plan_id": "p1", "members": [{"replica": "a", "generation": 1}, {"replica": "b", "generation": 1}], "start_ts": 2, "end_ts": 6, "policy": "wait", "late_grace": 1}},
    {"op": "stage.receipt", "args": {"receipt_id": "r1", "stage_id": "s1", "replica": "a", "generation": 1, "digest": "newhash"}},
